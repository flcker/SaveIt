{
  "name": "saveit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Save web pages as single HTML files with multi-level navigation support",
  "license": "AGPL-3.0",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "build:chrome": "cross-env TARGET=chrome vite build",
    "build:all": "vite build && cross-env TARGET=chrome vite build",
    "start:firefox": "web-ext run --source-dir dist",
    "icons": "tsx scripts/generate-icons.ts",
    "test": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/firefox-webext-browser": "^120.0.0",
    "cross-env": "^7.0.3",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^2.1.0",
    "web-ext": "^8.3.0"
  }
}
